# Copie para .env e preencha com os valores do seu ambiente.

# URL do backend (Render em produção). Em dev, deixe vazio para usar o proxy do Vite.
VITE_API_URL=http://localhost:3001/api

# Fallback opcional para rotas GET de leitura quando o backend primário estiver
# inacessível (ex.: /api servido pelas functions da Vercel). Vazio = desativado.
VITE_API_FALLBACK_URL=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feature flags
VITE_DIAGNOSTIC_HYPOTHESES_ENABLED=true

# Google Analytics (GA4). Vazio = desativado. Só carrega depois que o usuário
# aceita cookies não essenciais no banner de consentimento.
VITE_GA_MEASUREMENT_ID=

# Google Ads. Vazio = desativado. Mesma regra de consentimento do GA4.
# ID no formato AW-XXXXXXXXX (nível de conta) e label da ação de conversão
# "cadastro confirmado". Se um dia houver outra conversão (ex.: compra), ela
# usa o MESMO ID com um label próprio.
VITE_GADS_CONVERSION_ID=
VITE_GADS_SIGNUP_LABEL=
